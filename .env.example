# GEMINI_API_KEY: Automatically injected by AI Studio at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected by AI Studio at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
VITE_PUBLIC_STORE_DOMAIN="https://dreamstore.app"

# REQUIRED before paid beta (configure in Cloud Run Secret Manager, NEVER commit values).
# All Cloud Run instances must share the same stable 32+ character secret.
# SERVER_SIGNING_SECRET="(set via secret manager)"
# SUPER_ADMIN_UID="(verified Firebase Auth UID of the platform administrator)"
#
# Safe by default: Paid checkout is OFF in production unless explicitly enabled.
# Never set this to "true" until live payment/restart/download E2E tests pass.
# DREAMSTORE_PAID_CHECKOUT_ENABLED="false"
#
# The Cloud Run service account must have Firebase Admin read/write access to
# project dulcet-trees-qk6n5, Firestore database
# ai-studio-dreamstore-fac8084d-6f5b-423c-9b66-3ce72d622890
# and the private Storage bucket dulcet-trees-qk6n5.firebasestorage.app.
#
# Enable Firebase Authentication > Sign-in method > Email/Password and Google.
# WARNING: The alternate /api/auth/email/* auth path stores users in ephemeral
# /tmp. Migrate legacy accounts before production; do NOT treat it as durable auth.

# OPTIONAL PAYONEER API CREDENTIALS (Disabled by default — Manual Payment Verification is active)
# Leave unset when you do not have approved Payoneer API credentials. Do not enter dummy credentials.
# PAYONEER_ENABLED="false"
# PAYONEER_PROGRAM_ID=""
# PAYONEER_CLIENT_ID=""
# PAYONEER_CLIENT_SECRET=""
# PAYONEER_API_USERNAME=""
# PAYONEER_API_PASSWORD=""
# PAYONEER_WEBHOOK_SECRET=""
# PAYONEER_ENV="sandbox"

# OPTIONAL EMAIL PROVIDER CONFIGURATION (Resend API)
# RESEND_API_KEY=""
# EMAIL_PROVIDER_URL="https://api.resend.com/emails"
# PASSWORD_RESET_FROM_EMAIL="DreamStore Security <security@dreamstore.app>"
# ORDER_NOTIFICATION_FROM_EMAIL="DreamStore Orders <orders@dreamstore.app>"


# OPTIONAL isolated Backend V2 only; keep commented in production.
# DREAMSTORE_V2_STAGING=1
# DREAMSTORE_V2_PROJECT_ID=demo-dreamstore-v2
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# VITE_DREAMSTORE_V2_STAGING=1
# VITE_DREAMSTORE_V2_PROJECT_ID=demo-dreamstore-v2
# Backend V2 remains on 127.0.0.1:8091; Vite proxies /api only in this opt-in mode.

# OPTIONAL private Supabase Storage for V2 CLOUD STAGING ONLY.
# Emulator mode continues using Firebase Storage emulator. Cloud Run project,
# project-number, database, service identity and signing-secret guards still apply.
# All values below are placeholders. Configure only in an approved staging runtime.
# DREAMSTORE_V2_STORAGE_PROVIDER="supabase"
# DREAMSTORE_V2_SUPABASE_URL="https://<staging-project-ref>.supabase.co"
# DREAMSTORE_V2_SUPABASE_ALLOWED_PROJECT_REFS="<staging-project-ref>"
# DREAMSTORE_V2_SUPABASE_BUCKET="<private-staging-bucket>"
# DREAMSTORE_V2_SUPABASE_ALLOWED_BUCKETS="<private-staging-bucket>"
# DREAMSTORE_V2_SUPABASE_SECRET_NAME="<staging-supabase-secret-id>"
# DREAMSTORE_V2_SUPABASE_ALLOWED_SECRET_NAMES="<staging-supabase-secret-id>"
# Put the server-only Supabase secret/service_role key in that Secret Manager
# secret, not in this file, VITE_* variables, client code, logs, issues or chat.
# Supabase mode must omit DREAMSTORE_V2_CLOUD_STAGING_STORAGE_BUCKET and its
# allowlist; no Firebase Storage bucket or Storage IAM role is needed in this mode.
# See docs/backend-v2/STORAGE_CONFIGURATION.md for the complete guard requirements.
