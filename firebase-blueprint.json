{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "A multi-vendor creator digital storefront on DreamStore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the store owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "storeSlug": {
          "type": "string",
          "description": "Unique URL slug for the storefront.",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
        },
        "storeName": {
          "type": "string",
          "description": "Display name of the store.",
          "minLength": 1,
          "maxLength": 100
        },
        "ownerName": {
          "type": "string",
          "description": "Public display name of the creator.",
          "minLength": 1,
          "maxLength": 100
        },
        "instagramHandle": {
          "type": "string",
          "description": "Optional creator Instagram handle.",
          "maxLength": 100
        },
        "sellerCountry": {
          "type": "string",
          "description": "Country of the seller.",
          "maxLength": 80
        },
        "productType": {
          "type": "string",
          "description": "Primary digital product category.",
          "maxLength": 100
        },
        "announcementText": {
          "type": "string",
          "description": "Top announcement bar text.",
          "minLength": 1,
          "maxLength": 240
        },
        "heroHeadingLine1": {
          "type": "string",
          "description": "First line of the storefront hero heading.",
          "minLength": 1,
          "maxLength": 120
        },
        "heroHeadingLine2": {
          "type": "string",
          "description": "Second rose-accented line of the storefront hero heading.",
          "minLength": 1,
          "maxLength": 120
        },
        "heroSubheading": {
          "type": "string",
          "description": "Hero subtitle describing the store.",
          "minLength": 1,
          "maxLength": 500
        },
        "heroButtonText": {
          "type": "string",
          "description": "Primary CTA button text.",
          "minLength": 1,
          "maxLength": 60
        },
        "heroImage": {
          "type": "string",
          "description": "Hero banner image URL or data URI.",
          "minLength": 1,
          "maxLength": 500000
        },
        "logoUrl": {
          "type": "string",
          "description": "Store logo or avatar URL.",
          "minLength": 1,
          "maxLength": 500000
        },
        "theme": {
          "type": "string",
          "description": "Store color palette theme.",
          "enum": [
            "blush-bloom",
            "lavender-cloud",
            "vanilla-studio",
            "midnight-muse",
            "peach-petal",
            "clean-canvas",
            "blush-princess",
            "lavender-dreams",
            "vanilla-bloom",
            "rose-garden",
            "midnight-fairy",
            "minimal-muse",
            "blush-rose",
            "warm-cream",
            "petal-peach",
            "rosewood"
          ]
        },
        "customAccentColor": {
          "type": "string",
          "description": "Optional seller-customized accent hex color.",
          "maxLength": 20
        },
        "currency": {
          "type": "string",
          "description": "Default store currency.",
          "enum": ["USD", "PKR", "INR", "GBP", "EUR", "AED", "SAR", "CAD", "AUD"]
        },
        "exchangeRatePkr": {
          "type": "number",
          "description": "Conversion rate from 1 USD to PKR."
        },
        "status": {
          "type": "string",
          "description": "Store platform status.",
          "enum": ["Active", "Pending", "Suspended"]
        },
        "plan": {
          "type": "string",
          "description": "Store subscription tier.",
          "enum": ["Free", "Pro", "Basic"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "storeSlug",
        "storeName",
        "ownerName",
        "announcementText",
        "heroHeadingLine1",
        "heroHeadingLine2",
        "heroSubheading",
        "heroButtonText",
        "heroImage",
        "logoUrl",
        "theme",
        "currency",
        "exchangeRatePkr",
        "status",
        "plan",
        "createdAt",
        "updatedAt"
      ]
    },
