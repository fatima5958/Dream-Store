rules_version = '2';
// Isolated V2 emulator only. Never deploy these over production V1 rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function owner(uid) { return verified() && request.auth.uid == uid; }
    match /users/{uid} { allow get: if owner(uid); }
    match /stores/{id} { allow read: if owner(resource.data.ownerId); }
    match /products/{id} {
      allow read: if owner(resource.data.ownerId);
      match /deliverables/{file} { allow get: if owner(resource.data.ownerId); }
    }
    // Public storefront/catalog reads are sanitized by the API. Every write,
    // including metrics, claims and entitlement data, uses Admin SDK endpoints.
    match /{document=**} { allow read, write: if false; }
  }
}
