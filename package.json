{
  "name": "dreamstore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "start": "node scripts/start.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:contracts": "node --test tests/secure-deliverables-contract.test.mjs tests/store-launch-contract.test.mjs",
    "test:server": "node --import tsx --test tests/server-runtime.test.mjs tests/http-security.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:v2": "node --import tsx --test tests/backend-v2.test.mjs tests/backend-auth-unit.test.mjs tests/backend-v2-repositories.test.mjs tests/backend-v2-finance.test.mjs",
    "start:backend-v2": "node scripts/start-backend-v2.mjs",
    "test:v2:unit": "node --experimental-strip-types --test tests/backend-auth-unit.test.mjs tests/backend-v2-repositories.test.mjs tests/backend-v2-finance.test.mjs",
    "test:v2:emulator": "node --import tsx --test tests/backend-v2-emulator.test.mjs",
    "cleanup:v2:uploads": "node scripts/cleanup-v2-uploads.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.546.0",
    "motion": "^14.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
